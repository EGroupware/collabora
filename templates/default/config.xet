<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="collabora.config.configuration" template="" lang="" group="0" version="17.1">
		<grid width="100%" class="admin-config egwGridView_grid">
			<columns>
				<column width="250px"/>
				<column/>
			</columns>
			<rows>
				<row valign="middle" height="40">
					<et2-description  value="Collabora server" label="%s:"></et2-description>
					<et2-hbox>
						<et2-url  id="newsettings[server]" width="300px" readonly="true" disabled="@epl"></et2-url>
						<et2-url  id="newsettings[server]" width="300px" disabled="!@epl"></et2-url>
						<et2-description  id="newsettings[server_status]" label="Status:" disabled="!@newsettings[server_status]" class="@newsettings[server_status_class]"></et2-description>
						<!-- hack to get class propagated: id="newsettings[server_status_class]" -->
					</et2-hbox>
				</row>
				<row disabled="@epl">
					<et2-description  value="EGroupware EPL is required to configure a custom Collabora server." span="all" href="https://www.egroupware.org/EPL" extraLinkTarget="_blank"></et2-description>
				</row>
				<row>
					<et2-description  value="Requirements / please note" span="all" class="subHeader"></et2-description>
				</row>
				<row height="30" valign="bottom">
					<et2-description  value="The Collabora server must be able to access your EGroupware installation!" span="all"></et2-description>
				</row>
				<row>
					<et2-description  value="A local installation not accessible from the internet will NOT work with a public Collabora server." span="all"></et2-description>
				</row>
				<row height="30" valign="bottom">
					<et2-description  value="Checking for user 'anonymous'" label="%s:"></et2-description>
					<et2-description  id="newsettings[anonymous_status]" class="@newsettings[anonymous_status_class]"></et2-description>
					<!-- hack to get class propagated: id="newsettings[anonymous_status_class]" -->
				</row>
				<row>
					<et2-description  span="2" value="An user 'anonymous' is required for Collabora to access files and also for sharing files."></et2-description>
				</row>
				<row height="30" valign="bottom">
					<et2-description  value="Local Collabora server" span="all" class="subHeader"></et2-description>
				</row>
				<row height="60">
					<et2-vbox>
						<et2-description  value="A local Collabora server can be installed with the 'egroupware-collabora-key' package."></et2-description>
						<et2-description  value="You need a support-key from the EGroupware GmbH shop, for a supported Collabora installation." href="https://www.egroupware.org/pricing#Onlineoffice" extraLinkTarget="_blank"></et2-description>
						<et2-description  value="A supported Collabora allows to use it with the ordered number of users - more than the demo or developer version, installed by default." colspan="2"></et2-description>
					</et2-vbox>
				</row>
				<!-- hack to get class propagated: id="newsettings[no_managed_collabora]" -->
				<row disabled="@newsettings[no_managed_collabora]">
					<et2-vbox>
						<et2-description  value="Support-key"></et2-description>
						<et2-button  noSubmit="true" image="attach" label="Choose file..." onclick="app.collabora.supportKeyUpload"></et2-button>
					</et2-vbox><et2-ai><et2-textarea  rows="5" width="100%" id="newsettings[support_key]"></et2-textarea></et2-ai>
				</row>
				<row disabled="@newsettings[no_managed_collabora]" height="30" valign="bottom">
					<!-- hack to get value propagated: id="newsettings[admin_page]" -->
					<et2-description  value="Admin console" onclick="window.open('{$cont['newsettings']['admin_page']}', '_blank');" style="font-weight: bold"></et2-description>
					<et2-description  value="{$cont['newsettings']['server']}{$cont['newsettings']['admin_page']}" statustext="(requires username and password below)" extraLinkTarget="_blank" href="{$cont['newsettings']['server']}{$cont['newsettings']['admin_page']}"></et2-description>
				</row>
				<row disabled="@newsettings[no_managed_collabora]">
					<et2-description  value="Username"></et2-description>
					<et2-textbox  id="newsettings[username]"></et2-textbox>
				</row>
				<row disabled="@newsettings[no_managed_collabora]">
					<et2-description  value="Password"></et2-description>
					<et2-password  id="newsettings[password]"></et2-password>
				</row>
				<row disabled="@newsettings[no_managed_collabora]">
					<et2-description  value="PDF resolution (dpi)"></et2-description>
					<et2-number  id="newsettings[pdf_resolution_dpi]" placeholder="96" min="96" max="385" step="1"></et2-number>
				</row>
				<row>
					<et2-description  value="Collabora settings directory"></et2-description>
					<et2-hbox>
						<et2-vfs-select  id="newsettings[settings_directory]" mode="select-dir" path="@newsettings[settings_directory][0]" onchange="widget.nextSibling.value=widget.value[0]"></et2-vfs-select>
						<et2-description  id="newsettings[settings_directory]"></et2-description>
					</et2-hbox>
				</row>
			</rows>
		</grid>
	</et2-template>
	<!-- The settings of Collabora's own settings page.  collabora-config.xet has the same for the preferences, but
	     admin_config only sends the newsettings[...] ids it finds in this file, so the tab has to be here too -->
	<et2-template  id="collabora.config.settings">
		<iframe name="collabora_settings_iframe" width="100%" height="99%"></iframe>
		<et2-textbox  id="newsettings[collabora_settings_iframe]" type="hidden"></et2-textbox>
		<et2-textbox  id="newsettings[token]" type="hidden"></et2-textbox>
		<et2-textbox  id="newsettings[wopi_url]" type="hidden"></et2-textbox>
		<script>
			// Collabora needs this in its iframe
			// This script runs while the template is still being built, after the page's "load" event has fired,
			// and the iframe ends up inside a shadow root, so wait for it to show up instead of listening for events
			const find_iframe = (root) => {
				const iframe = root.querySelector('iframe[name="collabora_settings_iframe"]');
				if(iframe)
				{
					return iframe;
				}
				for(const el of root.querySelectorAll('*'))
				{
					const found = el.shadowRoot ? find_iframe(el.shadowRoot) : null;
					if(found)
					{
						return found;
					}
				}
				return null;
			};
			let tries = 0;
			const init_timer = setInterval(() => {
				tries++;
				const iframe = find_iframe(document);
				if(iframe)
				{
					clearInterval(init_timer);
					const template = iframe.getRootNode().host.closest('et2-template');
					window.egw(window).applyFunc('app.collabora.init_settings_iframe', [iframe, template.getRoot().getArrayMgr('content').data.newsettings], window);
				}
				else if(tries === 50)
				{
					clearInterval(init_timer);
				}
			}, 200);
		</script>
	</et2-template>

	<et2-template  id="collabora.config" template="" lang="" group="0" version="17.1" layout="edit">
		<et2-tabbox  id="configuration|settings">
			<tabs>
				<tab id="configuration" label="Configuration"></tab>
				<tab id="settings" label="Collabora"></tab>
			</tabs>
			<tabpanels>
				<et2-template  id="collabora.config.configuration"></et2-template>
				<et2-template  id="collabora.config.settings" disabled="!$newsettings[collabora_settings_iframe]"></et2-template>
			</tabpanels>
		</et2-tabbox>
	</et2-template>
</overlay>
